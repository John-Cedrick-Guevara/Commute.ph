# Web app (Vite). Copy to .env and fill in from the Supabase project's API settings.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Only when the API is on another origin (otherwise /api is proxied to localhost:8000)
# VITE_API_URL=https://api.example.com
